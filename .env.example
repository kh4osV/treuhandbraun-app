# Expo liest EXPO_PUBLIC_* automatisch in process.env (Client-Bundle!).
# Hier stehen nur client-seitige Werte — KEIN sb_secret_, KEIN service-role.
#
# Dev gegen den isolierten Dev-Stack (eigenes Supabase-Projekt). In Prod
# auf die Prod-Werte + https://fluke-web... wechseln.

# Supabase (gleiche Werte wie web/.env bzw. web/.env.dev — publishable!)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Basis-URL der fluke-web Worker (Endpoint: <BASE>/api/intake/upload)
#   Dev : https://fluke-web-dev.fluketreuhand.workers.dev
#   Prod : https://fluke-web.fluketreuhand.workers.dev  (bzw. eigene Domain)
EXPO_PUBLIC_INTAKE_BASE_URL=https://fluke-web-dev.fluketreuhand.workers.dev
