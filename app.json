{
  "expo": {
    "name": "fluke Treuhand",
    "slug": "treuhandbraun-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ch.fluketreuhand.belege",
      "infoPlist": {
        "NSCameraUsageDescription": "Belege fotografieren und hochladen.",
        "NSPhotoLibraryUsageDescription": "Belege aus der Galerie hochladen."
      }
    },
    "android": {
      "package": "ch.fluketreuhand.belege",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Belege fotografieren und hochladen."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "e614587d-5c6c-4e96-b2e5-d8bd2f8785d3"
      }
    },
    "owner": "kh4osv"
  }
}
