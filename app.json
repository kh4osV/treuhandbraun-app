{
  "expo": {
    "name": "Fluke",
    "slug": "treuhandbraun-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "backgroundColor": "#0e1320",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ch.fluketreuhand.belege",
      "infoPlist": {
        "NSCameraUsageDescription": "Belege fotografieren und hochladen.",
        "NSPhotoLibraryUsageDescription": "Belege aus der Galerie hochladen."
      }
    },
    "android": {
      "package": "ch.fluketreuhand.belege",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0e1320"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Belege fotografieren und hochladen."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "e614587d-5c6c-4e96-b2e5-d8bd2f8785d3"
      }
    },
    "owner": "kh4osv",
    "updates": {
      "url": "https://u.expo.dev/e614587d-5c6c-4e96-b2e5-d8bd2f8785d3"
    }
  }
}
